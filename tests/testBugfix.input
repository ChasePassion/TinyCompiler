extern int printf(string format)

# 这个文件里的每个函数都对应一个曾经出过的 bug，改动代码生成逻辑时
# 记得跑一遍测试（tests/testBugfix.expected 里有对应的期望输出）。

# 1. return 写在 if/else 分支里也必须真的返回
int sign(int x){
    if( x < 0 ){
        return -1
    }else if( x > 0 ){
        return 1
    }else{
        return 0
    }
}

# 2. 比较运算必须按有符号处理（-5 < 3 为真）
int negative(){
    int a = -5
    int b = 3
    if( a < b ){
        return 1
    }
    return 0
}

# 3. 取模运算
int modulo(){
    int a = 17
    return a % 5
}

# 4. 整数直接当条件用，非 0 就是真（2 也是真）
int truthy(int n){
    if( n ){
        return 1
    }
    return 0
}

# 5. 三维数组的下标换算
int arrays(){
    int[2][3][4] cube
    int i
    int j
    int k
    for(i=0; i<2; i=i+1){
        for(j=0; j<3; j=j+1){
            for(k=0; k<4; k=k+1){
                cube[i][j][k] = i * 100 + j * 10 + k
            }
        }
    }
    return cube[1][2][3]
}

# 6. 浮点运算
double half(){
    double x = 5.0
    return x / 2.0
}

# 7. 调用后面才定义的函数
int later(int v){
    return v * 2
}

int main(){
    printf("sign(-5)=%d\n", sign(-5))
    printf("negative=%d\n", negative())
    printf("modulo=%d\n", modulo())
    printf("truthy(2)=%d\n", truthy(2))
    printf("truthy(0)=%d\n", truthy(0))
    printf("arrays=%d\n", arrays())
    printf("half=%f\n", half())
    printf("later(21)=%d\n", later(21))
    return 0
}
